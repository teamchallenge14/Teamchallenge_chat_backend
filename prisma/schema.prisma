generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id          String   @id @default(uuid())
  name        String   @unique
  createdAt   DateTime @default(now())

  domains     TenantDomain[]
  users       TenantUser[]
}

model TenantDomain {
  id        String @id @default(uuid())
  domain    String @unique  
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model TenantUser {
  id        String @id @default(uuid())

  userId    String
  tenantId  String
  tenantStatus AccountStatus @default(ACTIVE)

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  permissions TenantUserPermission[]

  createdAt DateTime @default(now())

  @@unique([userId, tenantId])
}

model TenantUserPermission {
  id           String @id @default(uuid())

  tenantUserId String
  permission   Permission

  tenantUser   TenantUser @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)

  @@unique([tenantUserId, permission])
}


model User {
  id                 String        @id @default(uuid())
  accountStatus      AccountStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  emailVerifiedAt    DateTime?
  identityVerifiedAt DateTime?

  authMethods        AuthMethod[]
  tenants            TenantUser[]
  data               UserData?
  userInterests      UserInterest[]
  randomMatchPreference RandomMatchPreference?
  ownedRooms         Room[]        @relation("RoomOwner")
  roomMembers        RoomMember[]
  roomReports        RoomReport[]
  emailVerifications EmailVerification[]
  passwordResets PasswordReset[]
  joinRequests       RoomJoinRequest[] 
}

model AuthMethod {
  id           String       @id @default(uuid())
  provider     AuthProvider
  providerId   String
  email        String?      @unique
  login        String?      @unique
  passwordHash String?
  userId       String
  createdAt    DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerId])
  @@unique([userId, provider])
}

model UserData {
  id           String   @id @default(uuid())
  userId       String   @unique
  firstName    String?  @db.VarChar(20)
  lastName     String?  @db.VarChar(20)
  description  String?
  avatar       String?
  profileTheme String?
  birthDate    DateTime?
  gender       Gender   @default(UNSPECIFIED)
  language     RoomLanguage?
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Interest {
  id        String           @id @default(uuid())
  name      String           @unique
  category  InterestCategory @default(OTHER)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  users UserInterest[]
  roomInterests RoomInterest[]
  randomMatchPreferenceInterests RandomMatchPreferenceInterest[]
}

model UserInterest {
  userId     String
  interestId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
}

model RandomMatchPreference {
  id        String   @id @default(uuid())
  userId    String   @unique
  minAge    Int?
  maxAge    Int?
  genders   Gender[] @default([])
  languages RoomLanguage[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests RandomMatchPreferenceInterest[]
}

model RandomMatchPreferenceInterest {
  preferenceId String
  interestId   String

  preference RandomMatchPreference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([preferenceId, interestId])
}

model Room {
  id        String         @id @default(uuid())
  name      String         @db.VarChar(100)
  type      RoomType
  status    RoomStatus     @default(ACTIVE)
  minAge    Int            @default(12)
  maxAge    Int            @default(100)
  languages RoomLanguage[]
  photoUrl  String?
  ownerId   String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  owner     User           @relation("RoomOwner", fields: [ownerId], references: [id])
  members   RoomMember[]
  interests RoomInterest[]
  media     Media[]
  reports   RoomReport[]
  joinRequests RoomJoinRequest[]
}

model Media {
  id           String   @id @default(uuid())
  roomId       String
  originalName String?
  resourceType String
  format       String
  bytes        Int
  publicId     String
  url          String
  secureUrl    String
  createdAt    DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([publicId])
}

model RoomMember {
  roomId   String
  userId   String
  role     RoomMemberRole @default(MEMBER)
  joinedAt DateTime       @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
}

model RoomInterest {
  roomId     String
  interestId String

  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([roomId, interestId])
}

model RoomJoinRequest {
  id        String   @id @default(uuid())
  roomId    String
  userId    String
  status    JoinRequestStatus @default(PENDING)
  createdAt DateTime @default(now())
  reviewedAt DateTime?

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId, status])
}

model RoomReport {
  id         String   @id @default(uuid())
  roomId     String
  reporterId String
  reason     String   @db.VarChar(100)
  details    String?  @db.VarChar(1000)
  createdAt  DateTime @default(now())

  room       Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reporter   User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId, createdAt])
  @@index([roomId])
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  email     String
  codeHash  String
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  email     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([userId])
  @@index([expiresAt])
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  BANNED
  DELETED
}

enum Permission {
  CHAT_READ
  CHAT_WRITE
  CHAT_DELETE
  CHAT_MODERATE

  USER_READ
  USER_UPDATE
  USER_DELETE

  TENANT_CREATE
  TENANT_DELETE
  TENANT_UPDATE
  TENANT_MODERATE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum AuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
  APPLEID
  GITHUB
  GUEST

}

enum InterestCategory {
  OTHER
  ENTERTAINMENT
  CREATIVITY
  LEARNING
  DEEP_TALKS
  SPORTS_FITNESS
  LIFESTYLE
}

enum RoomType {
  PUBLIC
  PRIVATE
}

enum RoomStatus {
  ACTIVE
}

enum RoomMemberRole {
  OWNER
  MEMBER
}

enum RoomLanguage {
  EN
  UK
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}
