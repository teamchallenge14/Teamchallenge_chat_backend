generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String        @id @default(uuid())
  accountStatus      AccountStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  emailVerifiedAt    DateTime?
  identityVerifiedAt DateTime?

  authMethods        AuthMethod[]
  data               UserData?
  userInterests      UserInterest[]
  ownedRooms         Room[]        @relation("RoomOwner")
  roomMembers        RoomMember[]
  emailVerifications EmailVerification[]
  passwordResets PasswordReset[]
}

model AuthMethod {
  id           String       @id @default(uuid())
  provider     AuthProvider
  providerId   String
  email        String?      @unique
  login        String?      @unique
  passwordHash String?
  userId       String
  createdAt    DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerId])
  @@unique([userId, provider])
}

model UserData {
  id           String   @id @default(uuid())
  userId       String   @unique
  firstName    String?  @db.VarChar(20)
  lastName     String?  @db.VarChar(20)
  description  String?
  avatar       String?
  profileTheme String?
  birthDate    DateTime?
  gender       Gender   @default(UNSPECIFIED)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Interest {
  id        String           @id @default(uuid())
  name      String           @unique
  category  InterestCategory @default(OTHER)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  users UserInterest[]
  roomInterests RoomInterest[]
}

model UserInterest {
  userId     String
  interestId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
}

model Room {
  id        String         @id @default(uuid())
  name      String         @db.VarChar(100)
  type      RoomType
  status    RoomStatus     @default(ACTIVE)
  minAge    Int            @default(12)
  maxAge    Int            @default(100)
  languages RoomLanguage[]
  photoUrl  String?
  ownerId   String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  owner     User           @relation("RoomOwner", fields: [ownerId], references: [id])
  members   RoomMember[]
  interests RoomInterest[]
  media     Media[]
}

model Media {
  id           String   @id @default(uuid())
  roomId       String
  originalName String?
  resourceType String
  format       String
  bytes        Int
  publicId     String
  url          String
  secureUrl    String
  createdAt    DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([publicId])
}

model RoomMember {
  roomId   String
  userId   String
  role     RoomMemberRole @default(MEMBER)
  joinedAt DateTime       @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
}

model RoomInterest {
  roomId     String
  interestId String

  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([roomId, interestId])
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  email     String
  codeHash  String
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  email     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([userId])
  @@index([expiresAt])
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  BANNED
  DELETED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum AuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
  APPLEID
  GITHUB
}

enum InterestCategory {
  OTHER
  ENTERTAINMENT
  CREATIVITY
  LEARNING
  DEEP_TALKS
  SPORTS_FITNESS
  LIFESTYLE
}

enum RoomType {
  PUBLIC
  PRIVATE
}

enum RoomStatus {
  ACTIVE
}

enum RoomMemberRole {
  OWNER
  MEMBER
}

enum RoomLanguage {
  EN
  UK
}
