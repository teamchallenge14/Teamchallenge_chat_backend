generator client {
  provider     = "prisma-client-js"
  url      = env("POSTGRES_DATABASE_URL")
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String        @id @default(uuid())
  accountStatus      AccountStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  emailVerifiedAt    DateTime?
  identityVerifiedAt DateTime?

  authMethods        AuthMethod[]
  data               UserData?
  userInterests      UserInterest[]
  emailVerifications EmailVerification[]
  passwordResets PasswordReset[]
}

model AuthMethod {
  id           String       @id @default(uuid())
  provider     AuthProvider
  providerId   String
  email        String?      @unique
  login        String?      @unique
  passwordHash String?
  userId       String
  createdAt    DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerId])
}

model UserData {
  id           String   @id @default(uuid())
  userId       String   @unique
  firstName    String?  @db.VarChar(20)
  lastName     String?  @db.VarChar(20)
  description  String?
  avatar       String?
  profileTheme String?
  age          Int?
  gender       Gender   @default(UNSPECIFIED)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Interest {
  id        String           @id @default(uuid())
  name      String           @unique
  category  InterestCategory @default(OTHER)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  users UserInterest[]
}

model UserInterest {
  userId     String
  interestId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  email     String
  codeHash  String
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  email     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([userId])
  @@index([expiresAt])
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  BANNED
  DELETED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum AuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
  APPLEID
  GITHUB
}

enum InterestCategory {
  OTHER
  ENTERTAINMENT
  CREATIVITY
  LEARNING
  DEEP_TALKS
  SPORTS_FITNESS
  LIFESTYLE
}
