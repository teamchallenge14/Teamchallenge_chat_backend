####################################
# DATABASES
####################################

POSTGRES_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/QTalk?schema=public
MONGO_DATABASE_URL=mongodb://localhost:27017/QTalk


####################################
# JWT
####################################

JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=3600s
REFRESH_TOKEN_EXPIRES_IN=7d


####################################
# REDIS
####################################

REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false


####################################
# SENTRY
####################################

SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project-id>
SENTRY_ENV=development
SENTRY_ENABLED=false


####################################
# APPLICATION
####################################

NODE_ENV=development
PORT=3000
SWAGGER_PATH=/api
FRONTEND_URL=http://localhost:3000

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173


####################################
# OAUTH
####################################

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret


####################################
# MAIL (NODEMAILER)
####################################

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM="Qtalk <no-reply@qtalk.com>"


####################################
# LOGGING
####################################

LOG_DIR=logs

# Morgan
MORGAN_ACCESS_LOG=access.log
MORGAN_ERROR_LOG=error.log

# Pino
PINO_LOG_LEVEL=info
